---
import { getCollection } from "astro:content";
import OurSuggestion from "../components/OurSuggestion.astro";
import Base from "../layouts/Base.astro";
import { formatDate, sourceMix } from "../lib/role";
import { SOURCE_TYPE_LABELS, SOURCE_TYPES } from "../lib/taxonomy";
import { url } from "../lib/url";

const roles = (await getCollection("roles")).sort(
  (a, b) => a.data.order - b.data.order,
);
const tools = await getCollection("tools");
const starters = await getCollection("starterSkills");

const allSources = roles.flatMap((r) => r.data.sources);
const mix = sourceMix(allSources);
const uniqueUrls = new Set(allSources.map((s) => s.url)).size;
const shiftCount = roles.reduce((n, r) => n + r.data.shifts.length, 0);
const reviewDates = [
  ...new Set(roles.map((r) => r.data.lastReviewed.toISOString())),
];
const reviewDate = formatDate(roles[0].data.lastReviewed);
const datedBefore2024 = allSources.filter(
  (s) => s.published && s.published.getUTCFullYear() < 2024,
).length;
const undated = allSources.filter((s) => !s.published).length;
const typeCounts = SOURCE_TYPES.map((type) => ({
  type,
  count: allSources.filter((s) => s.type === type).length,
}));
const perRole = roles.map((role) => ({
  role,
  total: role.data.sources.length,
  affiliated: sourceMix(role.data.sources).vendorAffiliated,
}));

const ISSUES_URL = "github.com/ykeren1975/sdlc-ai-era/issues";

const typeDefinitions: Record<(typeof SOURCE_TYPES)[number], string> = {
  research: "An academic paper or preprint (arXiv, conference, journal).",
  survey:
    "A report built on questionnaire or interview responses from many people.",
  official:
    "Guidance from a standards body, professional association, government, framework authors, or an open-source project documenting its own standard.",
  vendor:
    "A company's documentation, blog or case study about its own product, customers or internal practice.",
  practitioner:
    "An individual expert's or consultancy's article, newsletter, blog or technology radar.",
  news: "Journalism or news analysis.",
};

const h2 = "mb-3 scroll-mt-24 text-2xl font-semibold tracking-tight";
const card = "rounded-2xl border border-line bg-surface p-5 sm:p-6";
---

<Base
  title="About & method"
  description="What this site is, how its content was researched and checked, how sources are labelled, and how to report a mistake."
>
  <header class="mb-8 max-w-3xl">
    <p class="mb-2 text-sm font-medium text-accent">About & method</p>
    <h1 class="mb-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      How this guide is made, and how far to trust it
    </h1>
    <p class="text-lg leading-relaxed text-pretty text-muted">
      A dated snapshot of how {roles.length} software roles are changing with
      AI, researched with AI assistance and checked claim by claim against its
      sources. It is not peer reviewed.
    </p>
  </header>

  <nav aria-label="On this page" class="no-print mb-10">
    <ul class="flex flex-wrap gap-2 text-sm">
      {[
        ["what", "What it is"],
        ["process", "How content is made"],
        ["suggestion", "Our suggestion"],
        ["reviews", "Review dates"],
        ["sources", "Sources"],
        ["limitations", "Limitations"],
        ["corrections", "Corrections"],
      ].map(([id, label]) => (
        <li>
          <a
            href={`#${id}`}
            class="inline-flex min-h-11 items-center rounded-full border border-line px-3 text-muted no-underline hover:border-accent hover:text-ink"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="max-w-3xl space-y-12 leading-relaxed">
    <section id="what" aria-labelledby="what-heading" class="scroll-mt-24">
      <h2 id="what-heading" class={h2}>
        What it is, and who made it
      </h2>
      <p class="text-muted">
        Pick a role and the site shows how the work changes, the risks, skills
        and tools, and ready-made AI instructions.
      </p>
      <ul
        class="mt-4 flex flex-wrap gap-x-6 gap-y-2"
        aria-label="Site contents"
      >
        {[
          [roles.length, "roles", "about-roles"],
          [shiftCount, "described changes", "about-shifts"],
          [tools.length, "tools", "about-tools"],
          [starters.length, "starter AI instructions", "about-starters"],
        ].map(([n, label, id]) => (
          <li class="text-muted" data-testid={id}>
            <strong class="text-xl font-semibold text-ink">{n}</strong> {label}
          </li>
        ))}
      </ul>
      <p class="mt-4 text-muted">
        It is written by an independent editor and built with Claude Code.
        Claude Code is an Anthropic product, and a few sources on the site are
        published by Anthropic; they are labelled vendor-affiliated like any
        other.
      </p>
    </section>

    <section
      id="process"
      aria-labelledby="process-heading"
      class="scroll-mt-24"
    >
      <h2 id="process-heading" class={h2}>
        How content is made
      </h2>
      <ol class="space-y-3" data-testid="process-steps">
        {[
          [
            "Research",
            "An AI research agent reads current sources for one role and writes the page: each change, risk and tool with the sources it relies on.",
          ],
          [
            "Link check",
            "A script opens every external link in the content, and any link that doesn't resolve is fixed before the page goes out.",
          ],
          [
            "Independent fact-check",
            "A separate agent, which cannot edit files, compares every claim with its cited page and reports anything the source doesn't say.",
          ],
          [
            "Fix and re-check",
            "The editor fixes each reported problem, and the page is checked again until the report is clean.",
          ],
        ].map(([title, text], i) => (
          <li class={`${card} flex gap-4`}>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent-soft font-semibold text-accent">
              {i + 1}
            </span>
            <div>
              <h3 class="font-semibold">{title}</h3>
              <p class="text-muted">{text}</p>
            </div>
          </li>
        ))}
      </ol>
      <h3 class="mt-6 mb-2 font-semibold">Rules every page follows</h3>
      <ul class="list-disc space-y-1 pl-5 text-muted">
        <li>Every described change cites at least one source.</li>
        <li>
          Statistics appear only when the source contains that exact figure, and
          the passage is quoted in the source list.
        </li>
        <li>
          Claims about the AI era use sources published in 2024 or later. Older
          sources describe only how work used to be done.
        </li>
        <li>
          A finding from one company, study or person stays attributed to them
          ("At Google…", "In one study…"), and caveats such as small samples are
          kept.
        </li>
        <li>No vendor hype, and no "latest" or "new" without a date.</li>
      </ul>
    </section>

    <section
      id="suggestion"
      aria-labelledby="suggestion-heading"
      class="scroll-mt-24"
    >
      <h2 id="suggestion-heading" class={h2}>
        What “Our suggestion” means
      </h2>
      <p class="text-muted">
        Some sections are marked <OurSuggestion />: first steps, which tools to
        start with, related roles and the starter AI instructions. They are the
        editor's practical advice, based on the sources, and are not sourced
        claims themselves.
      </p>
    </section>

    <section
      id="reviews"
      aria-labelledby="reviews-heading"
      class="scroll-mt-24"
    >
      <h2 id="reviews-heading" class={h2}>
        Review dates
      </h2>
      <p class="text-muted" data-testid="review-explanation">
        {reviewDates.length === 1 ? (
          <>
            Every role page shows “Last reviewed {reviewDate}”. All{" "}
            {roles.length} roles share that date because the whole site was
            researched and fact-checked in one pass in{" "}
            {roles[0].data.lastReviewed.toLocaleDateString("en-GB", {
              month: "long",
              year: "numeric",
              timeZone: "UTC",
            })}
            .
          </>
        ) : (
          <>
            Each role page shows the date its content was last researched and
            fact-checked.
          </>
        )}{" "}
        Tools, prices and reports change quickly, so treat anything older than a
        few months as a starting point and check the linked source.
      </p>
    </section>

    <section
      id="sources"
      aria-labelledby="sources-heading"
      class="scroll-mt-24"
    >
      <h2 id="sources-heading" class={h2}>
        Sources and how they are labelled
      </h2>
      <p class="text-muted">
        Role pages cite{" "}
        <strong class="text-ink" data-testid="about-citations">
          {allSources.length}
        </strong>{" "}
        sources in total (<span data-testid="about-unique">{uniqueUrls}</span>{" "}
        distinct pages; a few are cited on more than one role). Each one is
        labelled by what the cited page is, and whether its publisher sells
        products or services in that space.
      </p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm" data-testid="type-table">
          <thead class="border-b border-line text-muted">
            <tr>
              <th scope="col" class="py-2 pr-4 font-medium">
                Label
              </th>
              <th scope="col" class="py-2 pr-4 font-medium">
                Meaning
              </th>
              <th scope="col" class="py-2 text-right font-medium">
                Sources
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {typeCounts.map(({ type, count }) => (
              <tr data-type={type}>
                <th scope="row" class="py-2 pr-4 align-top font-medium">
                  {SOURCE_TYPE_LABELS[type].label}
                </th>
                <td class="py-2 pr-4 align-top text-muted">
                  {typeDefinitions[type]}
                </td>
                <td class="py-2 text-right align-top tabular-nums">{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-muted">
        <strong class="text-ink" data-testid="about-affiliated">
          {mix.vendorAffiliated}
        </strong>{" "}
        of {allSources.length} are labelled <em>vendor-affiliated</em>: the
        publisher sells in the topic's space, as with a tool company's own
        survey or a consultancy's radar. That doesn't make a source wrong, but
        it's a reason to read it with its incentives in mind. When the label was
        unclear, the more cautious one was chosen.
      </p>
      <p class="mt-3 text-muted">
        {datedBefore2024 === 0
          ? "Every dated source was published in 2024 or later."
          : `${datedBefore2024} dated sources are from before 2024 and describe only earlier ways of working.`}{" "}
        {undated} sources show no publication date on the page, such as product
        documentation.
      </p>

      <h3 class="mt-6 mb-2 font-semibold">Vendor-affiliated sources by role</h3>
      <p class="mb-3 text-sm text-muted">
        Roles differ in how many of their sources come from publishers who sell
        in that space. Where the share is high, give the source links a closer
        look.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm" data-testid="role-mix-table">
          <thead class="border-b border-line text-muted">
            <tr>
              <th scope="col" class="py-2 pr-4 font-medium">
                Role
              </th>
              <th scope="col" class="py-2 pr-4 text-right font-medium">
                Sources
              </th>
              <th scope="col" class="py-2 text-right font-medium">
                Vendor-affiliated
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {perRole.map(({ role, total, affiliated }) => (
              <tr>
                <th scope="row" class="py-2 pr-4 font-normal">
                  <a href={url(`/roles/${role.id}#sources`)}>
                    {role.data.title}
                  </a>
                </th>
                <td class="py-2 pr-4 text-right tabular-nums">{total}</td>
                <td class="py-2 text-right tabular-nums">{affiliated}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section
      id="limitations"
      aria-labelledby="limitations-heading"
      class="scroll-mt-24"
    >
      <h2 id="limitations-heading" class={h2}>
        Known limitations
      </h2>
      <ul class="list-disc space-y-1 pl-5 text-muted">
        <li>
          AI-assisted research and checking reduce mistakes but don't remove
          them. Follow the source link before relying on a claim.
        </li>
        <li>Only English-language sources were used.</li>
        <li>
          Many industry reports are published by companies with something to
          sell; the labels above show where.
        </li>
        <li>
          Tools and reports change quickly, and the site is not updated
          continuously.
        </li>
        <li>
          Roles vary a lot between companies. The pages describe common
          patterns, not how every team works.
        </li>
      </ul>
    </section>

    <section
      id="corrections"
      aria-labelledby="corrections-heading"
      class={`${card} scroll-mt-24`}
    >
      <h2 id="corrections-heading" class={h2}>
        Found a mistake?
      </h2>
      <p class="text-muted">
        Open an issue on GitHub at{" "}
        <code class="font-mono text-ink break-all" data-testid="issues-url">
          {ISSUES_URL}
        </code>{" "}
        with the page, the claim and what the source actually says.
        <span class="text-sm" data-testid="issues-note">
          (Available once the site is published.)
        </span>
      </p>
    </section>
  </div>
</Base>
