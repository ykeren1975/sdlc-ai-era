---
import { ExternalLink } from "@lucide/astro";
import { getCollection } from "astro:content";
import Cite from "../components/Cite.astro";
import OurSuggestion from "../components/OurSuggestion.astro";
import Base from "../layouts/Base.astro";
import { ROLE_GROUPS } from "../lib/taxonomy";
import { url } from "../lib/url";

const roles = await getCollection("roles");
const starters = await getCollection("starterSkills");
const byRole = ROLE_GROUPS.flatMap((g) => g.roles)
  .map((id) => roles.find((r) => r.id === id))
  .filter((r) => !!r)
  .map((role) => ({
    role,
    skills: (role.data.starterSkills ?? [])
      .map((name) => starters.find((s) => s.id === `${role.id}/${name}`))
      .filter((s) => !!s),
  }));

// Official skills docs per client, as listed on agentskills.io (final URLs).
const clients = [
  { name: "Claude Code", href: "https://code.claude.com/docs/en/skills" },
  {
    name: "Claude (apps and API)",
    href: "https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview",
  },
  {
    name: "GitHub Copilot",
    href: "https://docs.github.com/en/copilot/concepts/agents/about-agent-skills",
  },
  {
    name: "VS Code",
    href: "https://code.visualstudio.com/docs/copilot/customization/agent-skills",
  },
  { name: "Cursor", href: "https://cursor.com/docs/context/skills" },
  {
    name: "ChatGPT & Codex",
    href: "https://learn.chatgpt.com/docs/build-skills",
  },
  { name: "Gemini CLI", href: "https://geminicli.com/docs/cli/skills/" },
  { name: "Kiro", href: "https://kiro.dev/docs/skills/" },
];

// Numbered sources; <Cite n={…}/> refers to these positions.
const sources = [
  {
    title: "Agent Skills: Overview",
    publisher: "agentskills.io",
    href: "https://agentskills.io/",
  },
  {
    title: "Agent Skills: Specification",
    publisher: "agentskills.io",
    href: "https://agentskills.io/specification",
  },
  {
    title: "Extend Claude with skills",
    publisher: "Claude Code docs",
    href: "https://code.claude.com/docs/en/skills",
  },
  {
    title: "Use skills in Claude",
    publisher: "Claude Help Center",
    href: "https://support.claude.com/en/articles/12512180-use-skills-in-claude",
  },
  {
    title: "About agent skills",
    publisher: "GitHub Docs",
    href: "https://docs.github.com/en/copilot/concepts/agents/about-agent-skills",
  },
  {
    title: "Build skills",
    publisher: "ChatGPT docs (OpenAI)",
    href: "https://learn.chatgpt.com/docs/build-skills",
  },
  {
    title: "anthropics/skills",
    publisher: "GitHub",
    href: "https://github.com/anthropics/skills",
  },
  {
    title: "openai/skills: Skills Catalog for Codex",
    publisher: "GitHub",
    href: "https://github.com/openai/skills",
  },
];

const example = `---
name: weekly-status-report
description: Drafts a weekly project status report from tracker exports and meeting notes. Use when asked for a status update, weekly report or stakeholder summary.
metadata:
  title: "Weekly status report"
---

# Weekly status report

## Steps
1. Ask for the tracker export and this week's notes if they are missing.
2. ...

## Before you finish
- Flag assumptions and anything a human must decide.`;

const ext = { target: "_blank", rel: "noopener noreferrer" };
const h2 = "text-2xl font-semibold tracking-tight";
const route = "rounded-2xl border border-line bg-surface p-5";
---

<Base
  title="Agent Skills guide"
  description="What Agent Skills are, how to use one in Claude, coding agents such as GitHub Copilot and Codex, or any AI chat, and copy-ready starter instructions for every SDLC role."
>
  <header class="mb-10 max-w-3xl">
    <p class="mb-3 text-sm font-medium text-accent">Guide</p>
    <h1 class="mb-4 text-4xl font-semibold tracking-tight sm:text-5xl">
      Agent Skills guide
    </h1>
    <p class="text-lg leading-relaxed text-pretty text-muted">
      Teach an AI tool how <em>you</em> do a task, once. A skill is a folder
      with a text file called <code class="font-mono text-base">SKILL.md</code>:
      a name, a description of when to use it, and step-by-step instructions.
    </p>
  </header>

  <div class="max-w-3xl space-y-12">
    <section aria-labelledby="what-heading">
      <h2 id="what-heading" class={`${h2} mb-3`}>
        What a skill is
      </h2>
      <div class="space-y-3 leading-relaxed">
        <p>
          Agent Skills is an open format, originally developed by Anthropic and
          released as an open standard. A tool first loads only each skill's
          name and description, and reads the full instructions when a task
          calls for them, so you can keep many skills available.
          <Cite n={1} />
        </p>
        <p>
          The <code class="font-mono">name</code> uses lowercase letters,
          numbers and hyphens, up to 64 characters, and must match the folder
          name. The <code class="font-mono">description</code> should say what
          the skill does and when to use it.
          <Cite n={2} />
        </p>
      </div>
      <pre
        class="mt-4 overflow-x-auto rounded-xl border border-line bg-surface p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap"
        tabindex="0"
        aria-label="Example SKILL.md"
      >{example}</pre>
    </section>

    <section aria-labelledby="install-heading" class="scroll-mt-20">
      <h2 id="install-heading" class={`${h2} mb-2`}>
        How to use one
      </h2>
      <p class="mb-4 text-muted">
        On your role page, open a starter instruction and choose{" "}
        <strong class="text-ink">Copy instructions</strong> or
        <strong class="text-ink">Download .zip</strong>. Then pick the route for
        the tool you use.
      </p>

      <div class="space-y-4" data-testid="install-routes">
        <div class={route}>
          <h3 class="text-lg font-semibold">Claude (web or desktop app)</h3>
          <ol class="mt-2 list-decimal space-y-1.5 pl-5 leading-relaxed marker:text-accent">
            <li>
              Make sure code execution is turned on in Settings › Capabilities.
              <Cite n={4} />
            </li>
            <li>
              Go to Customize › Skills, choose + › Create skill › Upload a
              skill.
              <Cite n={4} />
            </li>
            <li>
              Upload the .zip you downloaded. It contains the skill folder with
              its SKILL.md.
              <Cite n={4} />
            </li>
          </ol>
          <p class="mt-2 text-sm text-muted">
            Skills are available on Claude's Free, Pro, Max, Team and Enterprise
            plans.
            <Cite n={4} />
          </p>
        </div>

        <div class={route}>
          <h3 class="text-lg font-semibold">Coding agents</h3>
          <p class="mt-1 leading-relaxed">
            Unzip the folder into the tool's skills folder:
          </p>
          <ul class="mt-2 space-y-1.5 leading-relaxed">
            <li>
              <strong class="font-medium">Claude Code:</strong>{" "}
              <code class="font-mono text-sm">~/.claude/skills/</code> for all
              your projects, or{" "}
              <code class="font-mono text-sm">.claude/skills/</code> in one
              repository. Ask for the task, or type{" "}
              <code class="font-mono text-sm">/&lt;name&gt;</code>.
              <Cite n={3} />
            </li>
            <li>
              <strong class="font-medium">GitHub Copilot</strong> (cloud agent,
              CLI, and agent mode in VS Code and JetBrains IDEs):{" "}
              <code class="font-mono text-sm">.github/skills/</code> in a
              repository, or
              <code class="font-mono text-sm">~/.copilot/skills/</code> for
              yourself.
              <Cite n={5} />
            </li>
            <li>
              <strong class="font-medium">
                Codex and the ChatGPT desktop app:
              </strong>
              <code class="font-mono text-sm">.agents/skills/</code> in a
              repository, or
              <code class="font-mono text-sm">~/.agents/skills/</code> for
              yourself.
              <Cite n={6} />
            </li>
          </ul>
        </div>

        <div class={route}>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-lg font-semibold">Any other AI chat</h3>
            <OurSuggestion />
          </div>
          <p class="mt-1 leading-relaxed">
            Tools such as ChatGPT on the web or Microsoft 365 Copilot don't let
            you upload a standalone skill file, as far as their public
            documentation shows.
            <Cite n={6} /> You can still use the instructions: choose
            <strong>Copy instructions</strong>, paste them at the start of a new
            chat, then add your material. For repeat use, save them in the
            tool's custom instructions or project settings if it has them.
          </p>
        </div>
      </div>

      <p class="mt-5 text-sm text-muted">
        Other tools that support the format document their own skills folder:
      </p>
      <ul class="mt-2 flex flex-wrap gap-2 text-sm">
        {clients.map((c) => (
          <li>
            <a
              href={c.href}
              {...ext}
              class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 no-underline hover:border-accent"
            >
              {c.name}
              <ExternalLink class="size-3 text-muted" aria-hidden="true" />
              <span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-5 rounded-xl border border-line bg-before p-4 text-sm leading-relaxed">
        <p class="font-medium">Read a skill before you install it.</p>
        <p class="mt-1 text-muted">
          A skill can pre-approve tools for itself through{" "}
          <code class="font-mono">allowed-tools</code> in its frontmatter, so
          check that field in any skill you didn't write.
          <Cite n={3} /> The starter instructions on this site never use it.
        </p>
      </div>
    </section>

    <section aria-labelledby="starters-heading">
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <h2 id="starters-heading" class={h2}>
          Starter instructions by role
        </h2>
        <OurSuggestion />
      </div>
      <p class="mb-4 text-muted">
        Written for each role from its researched changes. Treat them as a
        starting point and adapt them to how your team works.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        {byRole.map(({ role, skills }) => (
          <div class="rounded-2xl border border-line bg-surface p-4">
            <a
              href={url(`/roles/${role.id}#agent-skills`)}
              class="font-semibold hover:text-accent"
            >
              {role.data.title}
            </a>
            <ul class="mt-2 space-y-1.5 text-sm">
              {skills.map((s) => (
                <li>
                  <a
                    href={url(`/roles/${role.id}#skill-${s.data.name}`)}
                    class="text-accent"
                    data-testid="guide-skill"
                  >
                    {s.data.metadata?.title ?? s.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="built-heading">
      <h2 id="built-heading" class={`${h2} mb-3`}>
        How this site uses the same idea
      </h2>
      <p class="leading-relaxed text-muted">
        This site was built with Claude Code. Repeated work is packaged as
        reusable commands, such as <code class="font-mono">/verify</code> for
        checks and tests and <code class="font-mono">/add-role</code> for
        research, and every role page was checked by a separate fact-checking
        agent before publishing.
      </p>
    </section>

    <section aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="mb-3 text-lg font-semibold">
        Sources
      </h2>
      <ol class="space-y-2 text-sm">
        {sources.map((s, i) => (
          <li id={`source-${i + 1}`} class="flex scroll-mt-20 gap-3">
            <span class="w-5 shrink-0 text-right text-muted">{i + 1}.</span>
            <span>
              <a
                href={s.href}
                {...ext}
                class="print-url font-medium hover:text-accent"
              >
                {s.title}
                <span class="sr-only">(opens in new tab)</span>
              </a>
              <span class="text-muted">
                {" "}
                · {s.publisher}, accessed 14 September 2026
              </span>
            </span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
