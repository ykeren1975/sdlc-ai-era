---
import { ArrowLeft, ChevronDown, ExternalLink } from "@lucide/astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import RoleIcon from "../../components/RoleIcon.astro";
import ShareActions from "../../components/ShareActions.astro";
import ShiftList from "../../components/ShiftList.astro";
import AgentSkills from "../../components/AgentSkills.astro";
import SkillsPanel from "../../components/SkillsPanel.astro";
import SourceRefs from "../../components/SourceRefs.astro";
import SummaryPanel from "../../components/SummaryPanel.astro";
import ToolList from "../../components/ToolList.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, splitFirstSentence } from "../../lib/role";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const roles = await getCollection("roles");
  return roles.map((role) => ({ params: { id: role.id }, props: { role } }));
}

interface Props {
  role: CollectionEntry<"roles">;
}

const { role } = Astro.props;
const { data } = role;
const { Content } = await render(role);

const sourceNumbers = new Map(data.sources.map((s, i) => [s.id, i + 1]));
const hasStart = !!data.first30Days?.length;

const sections = [
  { id: "shifts", label: "Your work" },
  { id: "tools", label: "Tools" },
  { id: "skills", label: "Your skills" },
  { id: "agent-skills", label: "Agent skills" },
  { id: "risks", label: "Risks" },
  ...(hasStart ? [{ id: "start", label: "First steps" }] : []),
  { id: "sources", label: "Sources" },
];
const h2 = "text-2xl font-semibold tracking-tight";
---

<Base title={data.title} description={data.summary}>
  <a
    href={url("/")}
    class="no-print mb-6 inline-flex items-center gap-1.5 text-sm text-muted no-underline hover:text-ink"
  >
    <ArrowLeft class="size-4" aria-hidden="true" /> All roles
  </a>

  <header class="mb-6">
    <div class="flex flex-wrap items-start gap-4">
      <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-accent-soft text-accent">
        <RoleIcon name={data.icon} class="size-7" />
      </span>
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          {data.title}
        </h1>
        <p class="mt-1 text-lg text-pretty text-muted">
          {data.tagline ?? data.summary}
        </p>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-muted" data-testid="last-reviewed">
        Last reviewed {formatDate(data.lastReviewed)}
      </p>
      <ShareActions />
    </div>
  </header>

  <SummaryPanel data={data} />

  <!-- Mobile: section chips -->
  <nav
    aria-label="On this page"
    class="no-print sticky top-0 z-10 -mx-4 mt-6 overflow-x-auto border-b border-line bg-paper/95 px-4 py-2 backdrop-blur lg:hidden"
  >
    <ul class="flex gap-2 text-sm whitespace-nowrap">
      {sections.map((s) => (
        <li>
          <a
            href={`#${s.id}`}
            class="block rounded-full border border-line bg-surface px-3 py-1 text-muted no-underline"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-8 lg:mt-12 lg:grid lg:grid-cols-[11rem_1fr] lg:gap-10">
    <nav aria-label="Sections" class="no-print hidden lg:block">
      <ul class="sticky top-8 space-y-1 border-l border-line text-sm">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="-ml-px block border-l border-transparent py-1 pl-4 text-muted no-underline hover:border-accent hover:text-ink"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="min-w-0 space-y-12">
      <section
        id="shifts"
        aria-labelledby="shifts-heading"
        class="scroll-mt-16"
      >
        <h2 id="shifts-heading" class={h2}>
          How your work changes
        </h2>
        <p class="mt-1 text-muted">
          Open any item to see before and now, with sources.
        </p>
        <div class="mt-3">
          <ShiftList shifts={data.shifts} sourceNumbers={sourceNumbers} />
        </div>
      </section>

      <section id="tools" aria-labelledby="tools-heading" class="scroll-mt-16">
        <h2 id="tools-heading" class={`${h2} mb-4`}>
          Tools
        </h2>
        <ToolList tools={data.tools} sourceNumbers={sourceNumbers} />
      </section>

      <section
        id="skills"
        aria-labelledby="skills-heading"
        class="scroll-mt-16"
      >
        <h2 id="skills-heading" class={`${h2} mb-4`}>
          Your skills
        </h2>
        <SkillsPanel skills={data.skills} />
      </section>

      <section
        id="agent-skills"
        aria-labelledby="agent-skills-heading"
        class="scroll-mt-16"
      >
        <h2 id="agent-skills-heading" class={`${h2} mb-2`}>
          Agent skills
        </h2>
        <AgentSkills roleId={role.id} data={data} />
      </section>

      <section id="risks" aria-labelledby="risks-heading" class="scroll-mt-16">
        <h2 id="risks-heading" class={`${h2} mb-4`}>
          Risks to watch
        </h2>
        <ul
          class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface"
          data-disclosure-group
        >
          {data.risks.map((risk) => {
            const { lead, rest } = splitFirstSentence(risk.text);
            return (
              <li class="print-break-avoid">
                {rest ? (
                  <details class="group">
                    <summary class="flex items-start gap-3 px-5 py-3.5 hover:bg-accent-soft">
                      <span class="flex-1 font-medium">{lead}</span>
                      <ChevronDown
                        class="no-print mt-1 size-4 shrink-0 text-muted transition-transform group-open:rotate-180"
                        aria-hidden="true"
                      />
                    </summary>
                    <p class="px-5 pb-4 text-sm leading-relaxed text-muted">
                      {rest}
                      <SourceRefs
                        ids={risk.sourceIds}
                        sourceNumbers={sourceNumbers}
                      />
                    </p>
                  </details>
                ) : (
                  <p class="px-5 py-3.5 font-medium">
                    {lead}
                    <SourceRefs
                      ids={risk.sourceIds}
                      sourceNumbers={sourceNumbers}
                    />
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </section>

      {hasStart && (
        <section
          id="start"
          aria-labelledby="start-heading"
          class="scroll-mt-16"
        >
          <div class="mb-4 flex flex-wrap items-baseline gap-3">
            <h2 id="start-heading" class={h2}>
              Your first steps
            </h2>
            <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
              Editorial
            </span>
          </div>
          <div class="grid gap-6 md:grid-cols-[3fr_2fr]">
            <ol class="space-y-3">
              {data.first30Days!.map((step, i) => (
                <li class="print-break-avoid flex gap-3 rounded-xl border border-line bg-surface p-4 text-sm leading-relaxed">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
                    {i + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
            <div class="space-y-3 text-sm leading-relaxed text-muted">
              <p class="text-xs font-medium tracking-wide uppercase">
                A week in this role now
              </p>
              <Content />
            </div>
          </div>
        </section>
      )}

      <section
        id="sources"
        aria-labelledby="sources-heading"
        class="scroll-mt-16"
      >
        <details class="group rounded-2xl border border-line bg-surface">
          <summary class="flex items-center justify-between gap-3 px-5 py-4">
            <h2 id="sources-heading" class="text-lg font-semibold">
              Sources{" "}
              <span class="font-normal text-muted">
                ({data.sources.length})
              </span>
            </h2>
            <ChevronDown
              class="no-print size-4 text-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <ol
            class="space-y-3 border-t border-line px-5 py-4 text-sm"
            data-testid="sources"
          >
            {data.sources.map((source, i) => (
              <li id={`source-${source.id}`} class="flex scroll-mt-16 gap-3">
                <span class="w-6 shrink-0 text-right text-muted">{i + 1}.</span>
                <div class="min-w-0">
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="print-url font-medium break-words hover:text-accent"
                  >
                    {source.title}
                    <ExternalLink
                      class="no-print ml-1 inline size-3.5 align-[-2px] text-muted"
                      aria-hidden="true"
                    />
                    <span class="sr-only">(opens in new tab)</span>
                  </a>
                  <p class="text-muted">
                    {source.publisher}
                    {source.published && <> · {formatDate(source.published)}</>}
                  </p>
                  {source.quote && (
                    <blockquote class="mt-1 border-l-2 border-line pl-3 text-muted italic">
                      “{source.quote}”
                    </blockquote>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </details>
      </section>
    </div>
  </div>
</Base>

<script>
  // Links into collapsed content (citations, starter skills): open the disclosure first.
  const openTarget = (hash: string) => {
    const target = hash ? document.querySelector(hash) : null;
    const details =
      target?.closest("details") ?? target?.querySelector("details");
    if (details) details.open = true;
  };
  document
    .querySelectorAll<HTMLAnchorElement>(
      'a[href^="#source-"], a[href^="#skill-"]',
    )
    .forEach((link) =>
      link.addEventListener("click", () => openTarget(link.hash)),
    );
  if (location.hash.startsWith("#skill-")) openTarget(location.hash);
</script>
