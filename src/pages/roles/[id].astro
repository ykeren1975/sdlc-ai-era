---
import {
  AlertTriangle,
  ArrowLeft,
  ChevronDown,
  CornerUpLeft,
  ExternalLink,
} from "@lucide/astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import AgentSkills from "../../components/AgentSkills.astro";
import CopyItemLink from "../../components/CopyItemLink.astro";
import OurSuggestion from "../../components/OurSuggestion.astro";
import PageEnhancements from "../../components/PageEnhancements.astro";
import RoleNeighbours from "../../components/RoleNeighbours.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import SourceTypeIcon from "../../components/SourceTypeIcon.astro";
import RoleIcon from "../../components/RoleIcon.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ShareActions from "../../components/ShareActions.astro";
import ShiftList from "../../components/ShiftList.astro";
import SkillsPanel from "../../components/SkillsPanel.astro";
import SourceRefs from "../../components/SourceRefs.astro";
import SummaryPanel from "../../components/SummaryPanel.astro";
import ToolList from "../../components/ToolList.astro";
import Base from "../../layouts/Base.astro";
import { riskIds } from "../../lib/anchors";
import { formatDate, sourceMix } from "../../lib/role";
import { SOURCE_TYPE_LABELS, sourceTypeCount } from "../../lib/taxonomy";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const roles = await getCollection("roles");
  return roles.map((role) => ({ params: { id: role.id }, props: { role } }));
}

interface Props {
  role: CollectionEntry<"roles">;
}

const { role } = Astro.props;
const { data } = role;
const { Content } = await render(role);

const sourceNumbers = new Map(data.sources.map((s, i) => [s.id, i + 1]));
const hasStart = !!data.first30Days?.length;
const riskAnchors = riskIds(data.risks);
const mix = sourceMix(data.sources);

// Order follows the visitor's questions: what changes → what to watch → what to learn → what to use → how to start.
const sections = [
  { id: "shifts", label: "How your work changes" },
  { id: "risks", label: "Risks to watch" },
  { id: "skills", label: "Skills to build" },
  { id: "tools", label: "Tools" },
  ...(hasStart ? [{ id: "start", label: "Your first steps" }] : []),
  { id: "agent-skills", label: "AI instructions to copy" },
  { id: "sources", label: "Sources" },
];
const sectionAttrs = { "data-role-section": "", class: "scroll-mt-24" };
---

<Base title={data.title} description={data.summary}>
  <a
    href={url("/")}
    class="no-print mb-2 inline-flex min-h-11 items-center gap-1.5 text-sm text-muted no-underline hover:text-ink sm:mb-6"
  >
    <ArrowLeft class="size-4" aria-hidden="true" /> All roles
  </a>

  <header class="mb-6">
    <div class="flex flex-wrap items-start gap-4">
      <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-accent-soft text-accent">
        <RoleIcon name={data.icon} class="size-7" />
      </span>
      <div class="min-w-0 flex-1">
        <h1
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
          tabindex="-1"
        >
          {data.title}
        </h1>
        <p class="mt-1 text-lg text-pretty text-muted">{data.tagline}</p>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <p class="text-sm text-muted" data-testid="last-reviewed">
          <a href={url("/about#reviews")} class="text-muted hover:text-accent">
            Last reviewed {formatDate(data.lastReviewed)}
          </a>
        </p>
        <EvidenceBadge sources={data.sources} />
      </div>
      <ShareActions />
    </div>
  </header>

  <SummaryPanel roleId={role.id} data={data} />

  <!-- Phone: section chips with current-section state -->
  <nav
    aria-label="On this page"
    class="no-print sticky top-0 z-10 -mx-4 mt-6 border-b border-line bg-paper/95 backdrop-blur lg:hidden"
  >
    <ul
      class="scroll-fade flex gap-2 overflow-x-auto px-4 py-2 text-sm whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-chip-scroller
    >
      {sections.map((s) => (
        <li>
          <a
            href={`#${s.id}`}
            data-section-link
            class="flex min-h-10 items-center rounded-full border border-line bg-surface px-3.5 text-muted no-underline aria-[current=location]:border-accent aria-[current=location]:bg-accent aria-[current=location]:text-on-accent"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-8 lg:mt-12 lg:grid lg:grid-cols-[12rem_1fr] lg:gap-10">
    <nav aria-label="Sections" class="no-print hidden lg:block">
      <ul
        class="sticky top-8 space-y-1 border-l border-line text-sm"
        data-testid="section-nav"
      >
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              data-section-link
              class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-muted no-underline hover:border-line hover:text-ink aria-[current=location]:border-accent aria-[current=location]:font-medium aria-[current=location]:text-ink"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="min-w-0 space-y-10 sm:space-y-14" data-testid="role-sections">
      <section id="shifts" aria-labelledby="shifts-heading" {...sectionAttrs}>
        <SectionHeading id="shifts">How your work changes</SectionHeading>
        <p class="no-print mt-1 text-muted">
          Open any item to see before and now, with sources.
        </p>
        <div class="mt-3">
          <ShiftList
            roleId={role.id}
            shifts={data.shifts}
            sourceNumbers={sourceNumbers}
          />
        </div>
      </section>

      <section id="risks" aria-labelledby="risks-heading" {...sectionAttrs}>
        <SectionHeading id="risks" class="mb-4">
          Risks to watch
        </SectionHeading>
        <ul class="space-y-2">
          {data.risks.map((risk, i) => (
            <li
              id={riskAnchors[i]}
              class="print-break-avoid scroll-mt-24"
              data-testid="risk"
            >
              <details class="group rounded-xl border border-line border-l-4 border-l-amber-500 bg-surface">
                <summary class="flex min-h-12 items-start gap-3 px-4 py-3.5 hover:bg-accent-soft">
                  <AlertTriangle
                    class="mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400"
                    aria-hidden="true"
                  />
                  <span class="flex-1 font-medium">
                    {risk.headline ?? risk.text}
                  </span>
                  <ChevronDown
                    class="no-print mt-1 size-4 shrink-0 text-muted transition-transform group-open:rotate-180"
                    aria-hidden="true"
                  />
                </summary>
                <div class="px-4 pb-3 pl-11">
                  <p class="text-[15px] leading-relaxed text-muted sm:text-sm">
                    {risk.text}
                    <SourceRefs
                      ids={risk.sourceIds}
                      sourceNumbers={sourceNumbers}
                    />
                  </p>
                  <div class="mt-1">
                    <CopyItemLink target={riskAnchors[i]} />
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>

      <section
        id="skills"
        aria-labelledby="skills-heading"
        data-print-hide="summary"
        {...sectionAttrs}
      >
        <SectionHeading id="skills">Skills to build</SectionHeading>
        <p class="mt-1 mb-4 text-muted">
          Human skills: what's new, what matters more, and what AI now does for
          you.
        </p>
        <SkillsPanel skills={data.skills} />
      </section>

      <section
        id="tools"
        aria-labelledby="tools-heading"
        data-print-hide="summary"
        {...sectionAttrs}
      >
        <SectionHeading id="tools" class="mb-3">
          Tools
        </SectionHeading>
        <ToolList tools={data.tools} sourceNumbers={sourceNumbers} />
      </section>

      {hasStart && (
        <section
          id="start"
          aria-labelledby="start-heading"
          data-print-hide="summary"
          {...sectionAttrs}
        >
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <SectionHeading id="start">Your first steps</SectionHeading>
            <OurSuggestion />
          </div>
          <div class="grid gap-6 md:grid-cols-[3fr_2fr]">
            <div>
              {[data.first30Days!.slice(0, 2), data.first30Days!.slice(2)].map(
                (steps, part) => {
                  const list = (
                    <ol
                      class="space-y-3"
                      start={part === 0 ? 1 : 3}
                      data-testid="first-steps"
                    >
                      {steps.map((step, i) => (
                        <li class="print-break-avoid flex gap-3 rounded-xl border border-line bg-surface p-3 text-[15px] leading-relaxed sm:p-4 sm:text-base">
                          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">
                            {i + 1 + (part === 0 ? 0 : 2)}
                          </span>
                          <span>{step}</span>
                        </li>
                      ))}
                    </ol>
                  );
                  if (steps.length === 0) return null;
                  // Phones: first two steps, the rest one tap away; open from md up.
                  return part === 0 ? (
                    list
                  ) : (
                    <details class="group/steps mt-3" data-open-from-md>
                      <summary class="no-print inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-accent md:hidden">
                        <span class="group-open/steps:hidden">
                          Show {steps.length} more steps
                        </span>
                        <span class="hidden group-open/steps:inline">
                          Show fewer steps
                        </span>
                        <ChevronDown
                          class="size-4 transition-transform group-open/steps:rotate-180"
                          aria-hidden="true"
                        />
                      </summary>
                      {list}
                    </details>
                  );
                },
              )}
            </div>
            <details
              class="group/week self-start"
              data-open-from-md
              data-print-hide="summary"
            >
              <summary class="flex min-h-11 items-center gap-2 text-sm font-semibold md:pointer-events-none">
                A week in this role now
                <ChevronDown
                  class="size-4 text-muted transition-transform group-open/week:rotate-180 md:hidden"
                  aria-hidden="true"
                />
              </summary>
              <div class="space-y-3 leading-relaxed text-muted">
                <Content />
              </div>
            </details>
          </div>
        </section>
      )}

      <section
        id="agent-skills"
        aria-labelledby="agent-skills-heading"
        data-print-hide="summary"
        {...sectionAttrs}
      >
        <p class="text-xs font-semibold tracking-wide text-accent uppercase">
          Agent Skills
        </p>
        <SectionHeading id="agent-skills" class="mb-2">
          AI instructions to copy
        </SectionHeading>
        <AgentSkills roleId={role.id} data={data} />
      </section>

      <section
        aria-labelledby="neighbours-heading"
        data-print-hide="summary"
        class="no-print"
      >
        <details
          class="group rounded-2xl border border-line bg-surface md:border-0 md:bg-transparent"
          data-open-from-md
        >
          <summary class="flex min-h-12 items-center justify-between gap-3 px-5 py-3 md:pointer-events-none md:mb-4 md:p-0">
            <div>
              <h2
                id="neighbours-heading"
                class="font-display text-lg font-semibold md:text-2xl md:tracking-tight"
              >
                Related roles
              </h2>
            </div>
            <ChevronDown
              class="size-4 shrink-0 text-muted transition-transform group-open:rotate-180 md:hidden"
              aria-hidden="true"
            />
          </summary>
          <div class="border-t border-line px-4 py-4 md:border-0 md:p-0">
            <RoleNeighbours roleId={role.id} />
          </div>
        </details>
      </section>

      <section
        id="sources"
        aria-labelledby="sources-heading"
        data-print-hide="summary"
        {...sectionAttrs}
      >
        <details class="group rounded-2xl border border-line bg-surface">
          <summary class="flex min-h-12 items-center justify-between gap-3 px-5 py-4">
            <div>
              <h2 id="sources-heading" class="font-display text-lg font-semibold">
                Sources{" "}
                <span class="font-normal text-muted">
                  ({data.sources.length})
                </span>
              </h2>
              <p class="text-sm text-muted" data-testid="source-mix">
                {mix.byType
                  .map(([type, n]) =>
                    sourceTypeCount(type as keyof typeof SOURCE_TYPE_LABELS, n),
                  )
                  .join(", ")}
                {" · "}
                {mix.vendorAffiliated} vendor-affiliated
              </p>
            </div>
            <ChevronDown
              class="no-print size-4 text-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <p class="no-print border-t border-line px-5 pt-3 text-sm text-muted">
            Each source is labelled by what the page is and whether its
            publisher sells in this space.{" "}
            <a href={url("/about#sources")}>How we label sources</a>
          </p>
          <ol class="space-y-2 px-3 py-3 text-sm" data-testid="sources">
            {data.sources.map((source, i) => (
              <li
                id={`source-${source.id}`}
                class="flex scroll-mt-24 gap-3 p-2"
              >
                <span class="w-6 shrink-0 text-right text-muted">{i + 1}.</span>
                <div class="min-w-0">
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="print-url font-medium break-words hover:text-accent"
                  >
                    {source.title}
                    <ExternalLink
                      class="no-print ml-1 inline size-3.5 align-[-2px] text-muted"
                      aria-hidden="true"
                    />
                    <span class="sr-only">(opens in new tab)</span>
                  </a>
                  <p class="text-muted">
                    {source.publisher}
                    {source.published && <> · {formatDate(source.published)}</>}
                  </p>
                  <p
                    class="mt-1 flex flex-wrap gap-1.5"
                    data-testid="source-type"
                  >
                    <span class="inline-flex items-center gap-1 rounded-full bg-before px-2 py-0.5 text-xs text-muted">
                      <SourceTypeIcon type={source.type} class="size-3.5" />
                      {SOURCE_TYPE_LABELS[source.type].label}
                    </span>
                    {source.vendorAffiliated && (
                      <span
                        class="rounded-full border border-line px-2 py-0.5 text-xs text-muted"
                        data-testid="vendor-affiliated"
                      >
                        Vendor-affiliated
                      </span>
                    )}
                  </p>
                  {source.quote && (
                    <blockquote class="mt-1 border-l-2 border-line pl-3 text-muted italic">
                      “{source.quote}”
                    </blockquote>
                  )}
                  <button
                    type="button"
                    hidden
                    data-back-to-text
                    class="no-print mt-1 inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-accent hover:bg-accent-soft"
                  >
                    <CornerUpLeft class="size-4" aria-hidden="true" /> Back to
                    text
                  </button>
                </div>
              </li>
            ))}
          </ol>
        </details>
      </section>
    </div>
  </div>

  <PageEnhancements />
</Base>
