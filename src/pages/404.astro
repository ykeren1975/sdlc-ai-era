---
import { ArrowRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import RoleIcon from "../components/RoleIcon.astro";
import Base from "../layouts/Base.astro";
import { ROLE_GROUPS } from "../lib/taxonomy";
import { url } from "../lib/url";

const roles = await getCollection("roles");
const ordered = ROLE_GROUPS.flatMap((g) => g.roles)
  .map((id) => roles.find((r) => r.id === id))
  .filter((r) => !!r);

// The site mark with one phase segment missing: the page that "fell out" of the loop.
const cx = 60;
const r = 44;
const segments = Array.from({ length: 7 }, (_, i) => {
  const a0 = (-90 + (i * 360) / 7 + 6) * (Math.PI / 180);
  const a1 = (-90 + ((i + 1) * 360) / 7 - 6) * (Math.PI / 180);
  return `M${cx + r * Math.cos(a0)} ${cx + r * Math.sin(a0)}A${r} ${r} 0 0 1 ${cx + r * Math.cos(a1)} ${cx + r * Math.sin(a1)}`;
});
---

<Base
  title="Page not found"
  description="This page doesn't exist. Pick a role or browse the lifecycle instead."
>
  <section class="mx-auto max-w-2xl py-6 text-center sm:py-12">
    <svg
      viewBox="0 0 120 120"
      class="not-found-mark mx-auto mb-6 size-28 text-accent"
      aria-hidden="true"
    >
      {segments.map((d, i) => (
        <path
          d={d}
          fill="none"
          stroke="currentColor"
          stroke-width="9"
          stroke-linecap="round"
          class:list={[i === 4 && "not-found-gap"]}
          stroke-opacity={i === 4 ? 1 : 0.35 + i * 0.08}
        />
      ))}
      <text
        x="60"
        y="70"
        text-anchor="middle"
        class="fill-ink font-display"
        font-size="28"
        font-weight="600"
      >
        404
      </text>
    </svg>
    <h1 class="mb-3 text-4xl sm:text-5xl">This page isn't in the loop</h1>
    <p class="mx-auto mb-8 max-w-lg text-lg text-pretty text-muted">
      The link may be old or mistyped. Pick your role below, or start from the
      lifecycle.
    </p>
    <div class="mb-10 flex flex-wrap justify-center gap-3">
      <a
        href={url("/")}
        class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 font-medium text-on-accent no-underline hover:opacity-90"
      >
        Go to the home page <ArrowRight class="size-4" aria-hidden="true" />
      </a>
      <a
        href={url("/about")}
        class="inline-flex min-h-11 items-center rounded-full border border-line bg-surface px-5 font-medium text-ink no-underline hover:border-accent"
      >
        About &amp; method
      </a>
    </div>
  </section>

  <section aria-labelledby="nf-roles" class="mx-auto max-w-4xl">
    <h2
      id="nf-roles"
      class="mb-4 text-center text-sm font-semibold tracking-wide text-muted uppercase"
    >
      All roles
    </h2>
    <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {ordered.map((role) => (
        <li>
          <a
            href={url(`/roles/${role.id}`)}
            class="group flex min-h-11 items-center gap-3 rounded-xl border border-line bg-surface p-3 no-underline hover:border-accent"
            data-testid="not-found-role"
          >
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent">
              <RoleIcon name={role.data.icon} class="size-4" />
            </span>
            <span class="font-medium group-hover:text-accent">
              {role.data.title}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .not-found-gap {
      animation: drift 3.2s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
  }
  @keyframes drift {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    50% {
      translate: 6px 10px;
      rotate: 14deg;
    }
  }
</style>
