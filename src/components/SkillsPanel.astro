---
import { ChevronDown } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  skills: CollectionEntry<"roles">["data"]["skills"];
}

const { skills } = Astro.props;
const groups = [
  {
    title: "New skills",
    hint: "Didn't really exist in the role before",
    items: skills.new,
    marker: "bg-accent",
    open: false,
  },
  {
    title: "More important now",
    hint: "Existing skills that AI makes more valuable",
    items: skills.amplified,
    marker: "bg-ink",
    open: false,
  },
  {
    title: "Less central",
    hint: "Still useful, but AI now does much of it",
    items: skills.lessImportant,
    marker: "bg-muted",
    open: false,
  },
];
---

<div class="grid gap-3 md:grid-cols-3 md:gap-4">
  {groups.map((group) => (
    // Collapsed on phones (except "New skills"); always open from md up.
    <details
      class="group rounded-xl border border-line bg-surface"
      open={group.open}
      data-open-from-md
      data-testid="skills-group"
    >
      <summary class="flex min-h-12 items-start justify-between gap-3 px-5 pt-4 pb-3 md:pointer-events-none">
        <span>
          <span class="block text-lg font-semibold">{group.title}</span>
          <span class="block text-sm text-muted">{group.hint}</span>
        </span>
        <ChevronDown
          class="no-print mt-1.5 size-4 shrink-0 text-muted transition-transform group-open:rotate-180 md:hidden"
          aria-hidden="true"
        />
      </summary>
      <ul class="space-y-2 px-5 pb-5 text-[15px] sm:text-sm">
        {group.items.map((item) => (
          <li class="flex gap-2.5">
            <span
              class:list={["mt-2 size-2 shrink-0 rounded-full", group.marker]}
              aria-hidden="true"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </details>
  ))}
</div>
