---
// Site mark: the seven SDLC phases as a loop, with a spark for AI at the centre.
interface Props {
  class?: string;
}
const { class: className = "size-7" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  data-logo
>
  <g
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    class="text-accent"
  >
    <path d="M17.10 4.55A11.5 11.5 0 0 1 24.26 8.00" stroke-opacity="1" />
    <path d="M25.64 9.72A11.5 11.5 0 0 1 27.41 17.47" stroke-opacity="0.9" />
    <path d="M26.91 19.62A11.5 11.5 0 0 1 21.96 25.84" stroke-opacity="0.8" />
    <path d="M19.97 26.79A11.5 11.5 0 0 1 12.03 26.79" stroke-opacity="0.7" />
    <path d="M10.04 25.84A11.5 11.5 0 0 1 5.09 19.62" stroke-opacity="0.6" />
    <path d="M4.59 17.47A11.5 11.5 0 0 1 6.36 9.72" stroke-opacity="0.5" />
    <path d="M7.74 8.00A11.5 11.5 0 0 1 14.90 4.55" stroke-opacity="0.4" />
  </g>
  <path
    d="M16 10.2c.5 3 2.8 5.3 5.8 5.8-3 .5-5.3 2.8-5.8 5.8-.5-3-2.8-5.3-5.8-5.8 3-.5 5.3-2.8 5.8-5.8Z"
    class="fill-ink"
  />
</svg>
