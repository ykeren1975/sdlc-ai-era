---
import { ChevronDown, Copy, Download, ExternalLink } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import {
  getStarterSkills,
  LICENSE_LABELS,
  resolveAgentSkills,
} from "../lib/role";
import { url } from "../lib/url";
import CopyItemLink from "./CopyItemLink.astro";
import OurSuggestion from "./OurSuggestion.astro";

interface Props {
  roleId: string;
  data: CollectionEntry<"roles">["data"];
}

const { roleId, data } = Astro.props;
const readyMade = await resolveAgentSkills(data.agentSkills);
const starters = await getStarterSkills(roleId, data.starterSkills);
const ext = { target: "_blank", rel: "noopener noreferrer" };
const btn =
  "inline-flex min-h-11 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium no-underline";
---

<div class="space-y-6" data-agent-skills>
  <p class="text-muted">
    Each one is a text file (<code class="font-mono text-sm">SKILL.md</code>)
    that tells an AI tool, step by step, how to do one task the way you want.
    Copy it into a chat, or add it to a tool that supports Agent Skills.{" "}
    <a href={url("/agent-skills")} class="font-medium text-accent">
      Which tools, and how
    </a>
  </p>

  {starters.length > 0 && (
    <div data-disclosure-group>
      <div class="mb-1 flex flex-wrap items-center gap-3">
        <h3 class="text-lg font-semibold">
          Starter instructions for this role
        </h3>
        <OurSuggestion />
      </div>
      <p class="mb-3 text-sm text-muted">
        Written from the changes above. Read and adapt one before you use it.
      </p>
      <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
        {starters.map(({ entry, raw, name, title, summary }) => (
          <li
            id={`skill-${name}`}
            class="print-break-avoid scroll-mt-24"
            data-testid="starter-skill"
          >
            <details class="group/skill">
              <summary class="flex min-h-12 items-start gap-3 px-5 py-4 hover:bg-accent-soft">
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold">{title}</span>
                  <span class="mt-0.5 block text-sm text-muted">{summary}</span>
                  <code class="mt-1 hidden font-mono text-xs text-muted sm:block">
                    {name}
                  </code>
                </span>
                <span class="no-print mt-0.5 hidden text-xs text-muted sm:inline">
                  View · Copy · Download
                </span>
                <ChevronDown
                  class="no-print mt-1 size-4 shrink-0 text-muted transition-transform group-open/skill:rotate-180"
                  aria-hidden="true"
                />
              </summary>

              <div class="space-y-4 border-t border-line px-5 py-4">
                <div class="no-print flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    data-copy-skill
                    class={`${btn} bg-accent text-on-accent hover:opacity-90`}
                  >
                    <Copy class="size-4" aria-hidden="true" /> Copy instructions
                  </button>
                  <a
                    href={url(`/skills/${roleId}/${name}.zip`)}
                    download={`${name}.zip`}
                    class={`${btn} border border-line bg-surface hover:border-accent`}
                    data-download-zip
                  >
                    <Download class="size-4" aria-hidden="true" /> Download .zip
                  </a>
                  <span
                    class="text-sm text-accent"
                    role="status"
                    aria-live="polite"
                    data-copy-skill-status
                  />

                  <CopyItemLink target={`skill-${name}`} />
                </div>

                <div
                  class="rounded-xl bg-before p-4 text-sm"
                  data-testid="how-to-use"
                  data-print-hide="summary full"
                >
                  <p class="mb-2 font-semibold">How to use it</p>
                  <ul class="space-y-2.5 leading-relaxed">
                    <li>
                      <strong class="font-medium">In any AI chat</strong>, such
                      as ChatGPT, Microsoft 365 Copilot or Claude: choose Copy
                      instructions, paste them at the start of a new chat, then
                      add your material. <OurSuggestion />
                    </li>
                    <li>
                      <strong class="font-medium">
                        Install it in Claude (web or desktop):
                      </strong>{" "}
                      download the .zip, then go to Customize › Skills › + ›
                      Create skill › Upload a skill. Code execution must be
                      turned on.{" "}
                      <a
                        href="https://support.claude.com/en/articles/12512180-use-skills-in-claude"
                        {...ext}
                        class="text-accent"
                      >
                        Claude help
                        <span class="sr-only"> (opens in new tab)</span>
                      </a>
                    </li>
                    <li>
                      <strong class="font-medium">
                        Install it in a coding agent
                      </strong>{" "}
                      such as Claude Code, GitHub Copilot or Codex: unzip the
                      folder into the tool's skills folder.{" "}
                      <a
                        href={url("/agent-skills#install-heading")}
                        class="text-accent"
                      >
                        Folder locations
                      </a>
                    </li>
                  </ul>
                </div>

                <details
                  class="group/file no-print"
                  data-print-keep-closed
                  data-print-hide="summary"
                >
                  <summary class="inline-flex min-h-10 items-center gap-1.5 text-sm font-medium text-accent">
                    <ChevronDown
                      class="size-4 transition-transform group-open/file:rotate-180"
                      aria-hidden="true"
                    />
                    Show the full file
                  </summary>
                  <p class="mt-2 mb-2 text-xs text-muted">
                    File name <code class="font-mono">SKILL.md</code>, in a
                    folder named <code class="font-mono">{name}</code>. When to
                    use it: {entry.data.description}
                  </p>
                  <pre
                    class="max-h-96 overflow-auto rounded-xl bg-before p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap print:max-h-none print:overflow-visible"
                    tabindex="0"
                    aria-label={`${name} SKILL.md`}
                    data-skill-source
                  >{raw}</pre>
                </details>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  )}

  {readyMade.length > 0 && (
    <details class="group/published" data-open-from-md>
      <summary class="flex min-h-12 items-start justify-between gap-3 md:pointer-events-none">
        <span>
          <span class="block text-lg font-semibold">
            Published skills you can reuse
            <span class="font-normal text-muted md:hidden">
              ({readyMade.length})
            </span>
          </span>
          <span class="mb-3 block text-sm text-muted">
            From public skill catalogs. Check the license before use.
          </span>
        </span>
        <ChevronDown
          class="no-print mt-1.5 size-4 shrink-0 text-muted transition-transform group-open/published:rotate-180 md:hidden"
          aria-hidden="true"
        />
      </summary>
      <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
        {readyMade.map(({ entry, useFor }) => (
          <li class="print-break-avoid px-4 py-3" data-testid="ready-skill">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <a
                href={entry.data.url}
                {...ext}
                class="print-url inline-flex items-center gap-1.5 font-mono text-sm font-semibold hover:text-accent"
              >
                {entry.data.name}
                <ExternalLink class="no-print size-3.5" aria-hidden="true" />
                <span class="sr-only">(opens in new tab)</span>
              </a>
              <span class="flex items-center gap-2 text-xs text-muted">
                {entry.data.catalog}
                <span class="rounded-full border border-line px-2 py-0.5">
                  {LICENSE_LABELS[entry.data.license]}
                </span>
              </span>
            </div>
            <p class="mt-0.5 text-sm leading-relaxed text-muted">{useFor}</p>
          </li>
        ))}
      </ul>
    </details>
  )}
</div>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-skill]")
    .forEach((button) => {
      const panel = button.closest("li");
      const source = panel?.querySelector("[data-skill-source]");
      const status = panel?.querySelector("[data-copy-skill-status]");
      button.addEventListener("click", async () => {
        try {
          // Copy the instructions only: the YAML header is for tools, and looks broken pasted into a chat.
          const body = (source?.textContent ?? "").replace(
            /^---\n[\s\S]*?\n---\n+/,
            "",
          );
          await navigator.clipboard.writeText(body);
          if (status) status.textContent = "Copied";
        } catch {
          if (status)
            status.textContent =
              "Couldn't copy; open 'Show the full file' and select the text";
        }
        setTimeout(() => status && (status.textContent = ""), 3000);
      });
    });
</script>
