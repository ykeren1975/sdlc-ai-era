---
import { ExternalLink } from "@lucide/astro";
import { getEntry, type CollectionEntry } from "astro:content";
import { TOOL_CATEGORY_LABELS } from "../lib/taxonomy";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  tools: CollectionEntry<"roles">["data"]["tools"];
  sourceNumbers: Map<string, number>;
}

const { tools, sourceNumbers } = Astro.props;

const resolved = await Promise.all(
  tools.map(async (item) => {
    const entry = await getEntry(item.tool);
    if (!entry) throw new Error(`Unknown tool id "${item.tool.id}"`);
    return { ...item, entry };
  }),
);
// "should" first, keep authored order within each group
const sorted = [
  ...resolved.filter((t) => t.recommendation === "should"),
  ...resolved.filter((t) => t.recommendation === "could"),
];
---

<ul class="grid gap-4 sm:grid-cols-2">
  {sorted.map(({ entry, useFor, recommendation, sourceIds }) => (
    <li
      class="flex flex-col gap-2 rounded-xl border border-line bg-surface p-5"
      data-testid="tool"
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <a
            href={entry.data.url}
            class="inline-flex items-center gap-1.5 font-semibold hover:text-accent"
            rel="noopener"
          >
            {entry.data.name}
            <ExternalLink class="size-3.5" aria-hidden="true" />
          </a>
          <p class="text-xs text-muted">
            {entry.data.vendor} · {TOOL_CATEGORY_LABELS[entry.data.category]}
          </p>
        </div>
        <span
          class:list={[
            "shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium",
            recommendation === "should"
              ? "bg-accent text-surface"
              : "border border-line text-muted",
          ]}
        >
          {recommendation === "should" ? "Should use" : "Could use"}
        </span>
      </div>
      <p class="text-sm leading-relaxed">
        {useFor}
        <SourceRefs ids={sourceIds} sourceNumbers={sourceNumbers} />
      </p>
    </li>
  ))}
</ul>
