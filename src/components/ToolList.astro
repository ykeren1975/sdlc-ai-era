---
import { ExternalLink } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { TOOL_CATEGORY_LABELS } from "../lib/taxonomy";
import { resolveTools } from "../lib/role";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  tools: CollectionEntry<"roles">["data"]["tools"];
  sourceNumbers: Map<string, number>;
}

const { tools, sourceNumbers } = Astro.props;
const resolved = await resolveTools(tools);
const groups = [
  {
    title: "Should use",
    hint: "Widely adopted and core to the role",
    items: resolved.filter((t) => t.recommendation === "should"),
  },
  {
    title: "Could use",
    hint: "Worth a look depending on your context",
    items: resolved.filter((t) => t.recommendation === "could"),
  },
].filter((g) => g.items.length > 0);
---

<div class="grid gap-6 lg:grid-cols-2">
  {groups.map((group) => (
    <div>
      <h3 class="font-semibold">{group.title}</h3>
      <p class="mb-2 text-xs text-muted">{group.hint}</p>
      <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
        {group.items.map(({ entry, useFor, sourceIds }) => (
          <li class="print-break-avoid px-4 py-3" data-testid="tool">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <a
                href={entry.data.url}
                class="print-url inline-flex items-center gap-1.5 font-medium hover:text-accent"
                rel="noopener"
              >
                {entry.data.name}
                <ExternalLink class="no-print size-3.5" aria-hidden="true" />
              </a>
              <span class="text-xs text-muted">
                {entry.data.vendor} ·{" "}
                {TOOL_CATEGORY_LABELS[entry.data.category]}
              </span>
            </div>
            <p class="mt-0.5 text-sm leading-relaxed text-muted">
              {useFor}
              <SourceRefs ids={sourceIds} sourceNumbers={sourceNumbers} />
            </p>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
