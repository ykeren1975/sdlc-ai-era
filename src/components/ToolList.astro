---
import { ExternalLink } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { TOOL_CATEGORY_LABELS } from "../lib/taxonomy";
import { resolveTools } from "../lib/role";
import OurSuggestion from "./OurSuggestion.astro";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  tools: CollectionEntry<"roles">["data"]["tools"];
  sourceNumbers: Map<string, number>;
}

const { tools, sourceNumbers } = Astro.props;
const resolved = await resolveTools(tools);
const startHere = resolved.filter((t) => t.recommendation === "should");
const alsoWorth = resolved.filter((t) => t.recommendation === "could");
---

<div class="space-y-6">
  <p class="flex flex-wrap items-center gap-2 text-sm text-muted">
    Grouped by how widely each tool is used for this role. <OurSuggestion />
  </p>

  {startHere.length > 0 && (
    <div>
      <h3 class="text-lg font-semibold">Start here</h3>
      <p class="mb-2 text-sm text-muted">Widely used and core to this role</p>
      <ul class="grid gap-3 md:grid-cols-2">
        {startHere.map(({ entry, useFor, sourceIds }) => (
          <li
            class="print-break-avoid rounded-2xl border border-accent/30 bg-accent-soft/40 p-4"
            data-testid="tool"
          >
            <a
              href={entry.data.url}
              class="print-url inline-flex items-center gap-1.5 font-semibold hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              {entry.data.name}
              <ExternalLink class="no-print size-3.5" aria-hidden="true" />
              <span class="sr-only">(opens in new tab)</span>
            </a>
            <p class="text-xs text-muted">
              {entry.data.vendor} · {TOOL_CATEGORY_LABELS[entry.data.category]}
            </p>
            <p class="mt-2 text-sm leading-relaxed">
              {useFor}
              <SourceRefs ids={sourceIds} sourceNumbers={sourceNumbers} />
            </p>
          </li>
        ))}
      </ul>
    </div>
  )}

  {alsoWorth.length > 0 && (
    <div>
      <h3 class="text-lg font-semibold">Also worth a look</h3>
      <p class="mb-2 text-sm text-muted">Depends on your team and stack</p>
      <ul class="grid gap-x-6 md:grid-cols-2">
        {alsoWorth.map(({ entry, useFor, sourceIds }) => (
          <li
            class="print-break-avoid border-b border-line py-3"
            data-testid="tool"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <a
                href={entry.data.url}
                class="print-url inline-flex items-center gap-1.5 font-medium hover:text-accent"
                target="_blank"
                rel="noopener noreferrer"
              >
                {entry.data.name}
                <ExternalLink class="no-print size-3.5" aria-hidden="true" />
                <span class="sr-only">(opens in new tab)</span>
              </a>
              <span class="text-xs text-muted">{entry.data.vendor}</span>
            </div>
            <p class="mt-0.5 text-sm leading-relaxed text-muted">
              {useFor}
              <SourceRefs ids={sourceIds} sourceNumbers={sourceNumbers} />
            </p>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
