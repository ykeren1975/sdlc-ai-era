---
import { ChevronDown, Link, Printer } from "@lucide/astro";

const btn =
  "inline-flex min-h-11 items-center gap-2 rounded-lg border border-line bg-surface px-3 py-2 text-sm font-medium hover:border-accent";
---

<div class="no-print flex flex-wrap items-center gap-2" data-share>
  <details class="relative" data-print-menu>
    <summary class={btn}>
      <Printer class="size-4" aria-hidden="true" />
      <span class="max-sm:sr-only">Print / Save as PDF</span>
      <ChevronDown class="size-4 text-muted" aria-hidden="true" />
    </summary>
    <div
      class="absolute right-0 z-20 mt-2 w-64 rounded-xl border border-line bg-raised p-2 shadow-lg"
      role="group"
      aria-label="Print options"
    >
      <button
        type="button"
        data-print="summary"
        class="focus-inset flex min-h-11 w-full flex-col items-start rounded-lg px-3 py-2 text-left hover:bg-accent-soft"
      >
        <span class="text-sm font-medium">Summary</span>
        <span class="text-sm text-muted">Headlines only, about 2 pages</span>
      </button>
      <button
        type="button"
        data-print="full"
        class="focus-inset flex min-h-11 w-full flex-col items-start rounded-lg px-3 py-2 text-left hover:bg-accent-soft"
      >
        <span class="text-sm font-medium">Full page</span>
        <span class="text-sm text-muted">
          Everything expanded, with sources
        </span>
      </button>
    </div>
  </details>
  <button type="button" data-copy-link class={btn}>
    <Link class="size-4" aria-hidden="true" />
    <span class="max-sm:sr-only">Copy page link</span>
  </button>
  <span
    class="text-sm text-accent"
    role="status"
    aria-live="polite"
    data-copy-status
  ></span>
</div>

<script>
  const root = document.documentElement;
  const menu = document.querySelector<HTMLDetailsElement>("[data-print-menu]");

  document
    .querySelectorAll<HTMLButtonElement>("[data-print]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        root.dataset.print = button.dataset.print;
        if (menu) menu.open = false;
        window.print();
      }),
    );

  const status = document.querySelector("[data-copy-status]");
  document
    .querySelector("[data-copy-link]")
    ?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href.split("#")[0]);
        if (status) status.textContent = "Link copied";
      } catch {
        if (status) status.textContent = "Couldn't copy; use the address bar";
      }
      setTimeout(() => status && (status.textContent = ""), 3000);
    });

  // Print: "full" (the default, e.g. Ctrl+P) opens every disclosure except full SKILL.md sources;
  // "summary" keeps them closed so only headlines print. Restore afterwards.
  let opened: HTMLDetailsElement[] = [];
  addEventListener("beforeprint", () => {
    if ((root.dataset.print ?? "full") === "summary") return;
    opened = [
      ...document.querySelectorAll<HTMLDetailsElement>(
        "details:not([open]):not([data-print-keep-closed])",
      ),
    ];
    opened.forEach((d) => (d.open = true));
  });
  addEventListener("afterprint", () => {
    opened.forEach((d) => (d.open = false));
    opened = [];
    delete root.dataset.print;
  });

  // "Expand all / Collapse all" for each disclosure group.
  document
    .querySelectorAll<HTMLElement>("[data-disclosure-group]")
    .forEach((group) => {
      const button =
        group.querySelector<HTMLButtonElement>("[data-toggle-all]");
      if (!button) return;
      const all = () => [
        ...group.querySelectorAll<HTMLDetailsElement>(
          ":scope details:not([data-print-keep-closed])",
        ),
      ];
      const sync = () => {
        button.textContent = all().every((d) => d.open)
          ? "Collapse all"
          : "Expand all";
      };
      button.addEventListener("click", () => {
        const open = !all().every((d) => d.open);
        all().forEach((d) => (d.open = open));
        sync();
      });
      all().forEach((d) => d.addEventListener("toggle", sync));
    });
</script>
