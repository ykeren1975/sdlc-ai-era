---
// Renders citation links like [1][3] pointing at the sources list.
// Links sit on the text baseline with padding for a ≥24px target; no negative margins, so they never overlap text.
interface Props {
  ids?: string[];
  sourceNumbers: Map<string, number>;
}

const { ids = [], sourceNumbers } = Astro.props;
const numbered = ids
  .map((id) => ({ id, n: sourceNumbers.get(id) ?? 0 }))
  .sort((a, b) => a.n - b.n);
---

{numbered.length > 0 && (
  <span class="ml-0.5 whitespace-nowrap" data-citations>
    {numbered.map(({ id, n }) => (
      <sup class="align-baseline">
        <a
          href={`#source-${id}`}
          class="inline-flex min-h-6 min-w-6 items-center justify-center rounded px-0.5 align-middle text-[12px] leading-none text-accent no-underline hover:bg-accent-soft hover:underline"
          aria-label={`Source ${n}`}
        >
          [{n}]
        </a>
      </sup>
    ))}
  </span>
)}
