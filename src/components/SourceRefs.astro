---
// Renders superscript citation links like [1][3] pointing at the sources list.
interface Props {
  ids?: string[];
  sourceNumbers: Map<string, number>;
}

const { ids = [], sourceNumbers } = Astro.props;
const numbered = ids
  .map((id) => ({ id, n: sourceNumbers.get(id) ?? 0 }))
  .sort((a, b) => a.n - b.n);
---

{numbered.length > 0 && (
  <sup class="ml-1 inline-flex gap-1 whitespace-nowrap text-xs">
    {numbered.map(({ id, n }) => {
      return (
        <a
          href={`#source-${id}`}
          class="text-accent no-underline hover:underline"
          aria-label={`Source ${n}`}
        >
          [{n}]
        </a>
      );
    })}
  </sup>
)}
