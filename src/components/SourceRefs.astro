---
// Renders superscript citation links like [1][3] pointing at the sources list.
interface Props {
  ids?: string[];
  sourceNumbers: Map<string, number>;
}

const { ids = [], sourceNumbers } = Astro.props;
---

{ids.length > 0 && (
  <sup class="ml-0.5 whitespace-nowrap text-xs">
    {ids.map((id) => {
      const n = sourceNumbers.get(id);
      return (
        <a
          href={`#source-${id}`}
          class="text-accent no-underline hover:underline"
          aria-label={`Source ${n}`}
        >
          [{n}]
        </a>
      );
    })}
  </sup>
)}
