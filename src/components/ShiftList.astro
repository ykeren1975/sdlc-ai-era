---
import { ArrowRight, ChevronDown, History, Sparkles } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { changeIds } from "../lib/anchors";
import { handoffsFor } from "../lib/role";
import { PHASE_LABELS } from "../lib/taxonomy";
import { track } from "../lib/analytics";
import { url } from "../lib/url";
import CopyItemLink from "./CopyItemLink.astro";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  roleId: string;
  shifts: CollectionEntry<"roles">["data"]["shifts"];
  sourceNumbers: Map<string, number>;
}

const { roleId, shifts, sourceNumbers } = Astro.props;
const ids = changeIds(shifts);
// Links to the same handoff described on another role's page (src/data/handoffs.yaml).
const related = await Promise.all(
  shifts.map(async (shift) =>
    (await handoffsFor(roleId, shift.activity)).map(({ role, index }) => ({
      href: url(`/roles/${role.id}#${changeIds(role.data.shifts)[index]}`),
      roleId: role.id,
      roleTitle: role.data.title,
      activity: role.data.shifts[index].activity,
    })),
  ),
);
---

<div data-disclosure-group>
  <div class="no-print mb-2 flex justify-end">
    <button
      type="button"
      data-toggle-all
      class="min-h-11 rounded-lg px-3 text-sm font-medium text-accent hover:bg-accent-soft"
    >
      Expand all
    </button>
  </div>
  <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
    {shifts.map((shift, i) => (
      <li
        id={ids[i]}
        data-testid="shift"
        class="print-break-avoid scroll-mt-24"
      >
        <details class="group">
          <summary class="flex min-h-12 items-start gap-3 px-4 py-3 hover:bg-accent-soft sm:gap-4 sm:px-5 sm:py-3.5">
            <span class="mt-0.5 hidden w-24 shrink-0 text-xs font-medium tracking-wide text-muted uppercase sm:block">
              {PHASE_LABELS[shift.phase]}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[11px] font-medium tracking-wide text-muted uppercase sm:hidden">
                {PHASE_LABELS[shift.phase]}
              </span>
              <span class="block font-semibold">{shift.activity}</span>
              <span class="block text-[15px] text-muted sm:text-sm">
                {shift.headline}
              </span>
            </span>
            <ChevronDown
              class="no-print mt-1 size-4 shrink-0 text-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="bn relative border-t border-line" data-bn>
            <div
              class="bn-toggle no-print px-4 pt-3 sm:hidden"
              role="group"
              aria-label="Compare before and now"
              hidden
              data-bn-toggle
            >
              <div class="relative inline-grid grid-cols-2 rounded-full border border-line bg-before p-0.5 text-sm font-medium">
                <span
                  class="bn-thumb absolute inset-y-0.5 left-0.5 w-[calc(50%-2px)] rounded-full bg-surface shadow-sm transition-transform"
                  aria-hidden="true"
                />
                <button
                  type="button"
                  class="relative min-h-10 rounded-full px-4 text-muted aria-pressed:text-ink"
                  data-bn-show="before"
                  aria-pressed="false"
                >
                  Before AI
                </button>
                <button
                  type="button"
                  class="relative min-h-10 rounded-full px-4 text-muted aria-pressed:text-accent"
                  data-bn-show="now"
                  aria-pressed="true"
                >
                  With AI
                </button>
              </div>
            </div>
            <div class="grid sm:grid-cols-2">
              <div
                class="bn-before bg-before px-5 py-4 sm:pr-9"
                data-print-hide="summary"
                data-bn-panel="before"
              >
                <p class="mb-1 flex items-center gap-1.5 text-xs font-medium tracking-wide text-muted uppercase">
                  <History class="size-3.5" aria-hidden="true" />
                  <span>Before</span>
                </p>
                <p class="text-[15px] leading-relaxed text-muted sm:text-sm">
                  {shift.traditional}
                </p>
              </div>
              <span
                class="bn-arrow absolute top-1/2 left-1/2 z-10 hidden size-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent text-on-accent shadow-md ring-4 ring-surface sm:flex"
                aria-hidden="true"
              >
                <ArrowRight class="size-4" />
              </span>
              <div
                class="bn-now bg-surface px-5 py-4 sm:border-l sm:border-line sm:pl-9"
                data-bn-panel="now"
              >
                <p class="mb-1 flex items-center gap-1.5 text-xs font-medium tracking-wide text-accent uppercase">
                  <Sparkles class="size-3.5" aria-hidden="true" />
                  <span>Now</span>
                </p>
                <p class="text-[15px] leading-relaxed sm:text-sm">
                  {shift.aiEra}
                  <SourceRefs
                    ids={shift.sourceIds}
                    sourceNumbers={sourceNumbers}
                  />
                </p>
                {related[i].length > 0 && (
                  <ul
                    class="mt-3 space-y-1 border-t border-line pt-3 text-sm"
                    data-testid="handoff-links"
                  >
                    {related[i].map((r) => (
                      <li>
                        <a
                          href={r.href}
                          {...track("handoff", `${roleId}/${r.roleId}`)}
                          class="group/rel inline-flex min-h-10 items-start gap-1.5 py-1.5 font-medium text-accent no-underline hover:underline"
                        >
                          <span>
                            <span class="font-normal text-muted">
                              Related on the {r.roleTitle} page:
                            </span>{" "}
                            {r.activity}
                          </span>
                          <ArrowRight
                            class="mt-0.5 size-4 shrink-0 transition-transform group-hover/rel:translate-x-0.5"
                            aria-hidden="true"
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-2">
                  <CopyItemLink target={ids[i]} />
                </div>
              </div>
            </div>
          </div>
        </details>
      </li>
    ))}
  </ul>
</div>

<script>
  // Phones: show one side at a time with a Before AI / With AI switch (both sides show without JS and in print).
  for (const wrap of document.querySelectorAll<HTMLElement>("[data-bn]")) {
    const toggle = wrap.querySelector<HTMLElement>("[data-bn-toggle]");
    if (!toggle) continue;
    const set = (view: string) => {
      wrap.dataset.bnView = view;
      toggle
        .querySelectorAll<HTMLButtonElement>("[data-bn-show]")
        .forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.bnShow === view)),
        );
    };
    toggle.hidden = false;
    set("now");
    toggle.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-bn-show]",
      );
      if (btn?.dataset.bnShow) set(btn.dataset.bnShow);
    });
  }
</script>
