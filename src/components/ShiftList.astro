---
import { ArrowRight, ChevronDown } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { changeIds } from "../lib/anchors";
import { handoffsFor } from "../lib/role";
import { PHASE_LABELS } from "../lib/taxonomy";
import { url } from "../lib/url";
import CopyItemLink from "./CopyItemLink.astro";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  roleId: string;
  shifts: CollectionEntry<"roles">["data"]["shifts"];
  sourceNumbers: Map<string, number>;
}

const { roleId, shifts, sourceNumbers } = Astro.props;
const ids = changeIds(shifts);
// Links to the same handoff described on another role's page (src/data/handoffs.yaml).
const related = await Promise.all(
  shifts.map(async (shift) =>
    (await handoffsFor(roleId, shift.activity)).map(({ role, index }) => ({
      href: url(`/roles/${role.id}#${changeIds(role.data.shifts)[index]}`),
      roleTitle: role.data.title,
      activity: role.data.shifts[index].activity,
    })),
  ),
);
---

<div data-disclosure-group>
  <div class="no-print mb-2 flex justify-end">
    <button
      type="button"
      data-toggle-all
      class="min-h-11 rounded-lg px-3 text-sm font-medium text-accent hover:bg-accent-soft"
    >
      Expand all
    </button>
  </div>
  <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
    {shifts.map((shift, i) => (
      <li
        id={ids[i]}
        data-testid="shift"
        class="print-break-avoid scroll-mt-24"
      >
        <details class="group">
          <summary class="flex min-h-12 items-start gap-3 px-4 py-3 hover:bg-accent-soft sm:gap-4 sm:px-5 sm:py-3.5">
            <span class="mt-0.5 hidden w-24 shrink-0 text-xs font-medium tracking-wide text-muted uppercase sm:block">
              {PHASE_LABELS[shift.phase]}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[11px] font-medium tracking-wide text-muted uppercase sm:hidden">
                {PHASE_LABELS[shift.phase]}
              </span>
              <span class="block font-semibold">{shift.activity}</span>
              <span class="block text-[15px] text-muted sm:text-sm">
                {shift.headline}
              </span>
            </span>
            <ChevronDown
              class="no-print mt-1 size-4 shrink-0 text-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="grid gap-px border-t border-line bg-line sm:grid-cols-2">
            <div class="bg-before px-5 py-4" data-print-hide="summary">
              <p class="mb-1 text-xs font-medium tracking-wide text-muted uppercase">
                Before
              </p>
              <p class="text-[15px] leading-relaxed text-muted sm:text-sm">
                {shift.traditional}
              </p>
            </div>
            <div class="bg-surface px-5 py-4">
              <p class="mb-1 text-xs font-medium tracking-wide text-accent uppercase">
                Now
              </p>
              <p class="text-[15px] leading-relaxed sm:text-sm">
                {shift.aiEra}
                <SourceRefs
                  ids={shift.sourceIds}
                  sourceNumbers={sourceNumbers}
                />
              </p>
              {related[i].length > 0 && (
                <ul
                  class="mt-3 space-y-1 border-t border-line pt-3 text-sm"
                  data-testid="handoff-links"
                >
                  {related[i].map((r) => (
                    <li>
                      <a
                        href={r.href}
                        class="group/rel inline-flex min-h-10 items-start gap-1.5 py-1.5 font-medium text-accent no-underline hover:underline"
                      >
                        <span>
                          <span class="font-normal text-muted">
                            Related on the {r.roleTitle} page:
                          </span>{" "}
                          {r.activity}
                        </span>
                        <ArrowRight
                          class="mt-0.5 size-4 shrink-0 transition-transform group-hover/rel:translate-x-0.5"
                          aria-hidden="true"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-2">
                <CopyItemLink target={ids[i]} />
              </div>
            </div>
          </div>
        </details>
      </li>
    ))}
  </ul>
</div>
