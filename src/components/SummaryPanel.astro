---
import { AlertTriangle, ArrowRight, Check, ExternalLink } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { changeIds, riskIds } from "../lib/anchors";
import { getStarterSkills, resolveTools } from "../lib/role";

interface Props {
  roleId: string;
  data: CollectionEntry<"roles">["data"];
}

const { roleId, data } = Astro.props;
const shiftAnchors = changeIds(data.shifts);
const indexed = data.shifts.map((shift, i) => ({ shift, anchor: shiftAnchors[i] }));
const flagged = indexed.filter(({ shift }) => shift.highlight);
const highlights = (flagged.length ? flagged : indexed).slice(0, 3);
const topTools = (await resolveTools(data.tools)).slice(0, 3);
const topSkills = data.skills.new.slice(0, 2);
const riskIndex = Math.max(
  0,
  data.risks.findIndex((r) => r.highlight),
);
const watchOut = data.risks[riskIndex];
const [firstSkill] = await getStarterSkills(
  roleId,
  data.starterSkills?.slice(0, 1),
);
---

<section
  aria-labelledby="summary-heading"
  class="print-break-avoid rounded-2xl border border-accent/40 bg-accent-soft p-5 sm:p-6"
  data-testid="summary"
>
  <h2
    id="summary-heading"
    class="mb-4 text-sm font-semibold tracking-wide text-accent uppercase"
  >
    Top 3 changes for you
  </h2>

  <ol class="grid gap-2 sm:grid-cols-3 sm:gap-3">
    {highlights.map(({ shift, anchor }, i) => (
      <li data-testid="highlight">
        <a
          href={`#${anchor}`}
          class="group focus-inset flex h-full items-start gap-3 rounded-xl bg-raised p-3 no-underline hover:ring-2 hover:ring-accent/40 sm:flex-col sm:gap-0 sm:p-4"
        >
          <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-semibold text-on-accent sm:mb-2">
            {i + 1}
          </span>
          <span class="min-w-0 flex-1 sm:flex sm:flex-col">
            <span class="block font-semibold leading-snug">{shift.activity}</span>
            <span class="mt-0.5 block flex-1 text-sm leading-relaxed text-muted sm:mt-1">
              {shift.headline}
            </span>
          </span>
          <span class="no-print mt-3 hidden items-center gap-1 text-sm font-medium text-accent sm:inline-flex">
            See before &amp; now{" "}
            <ArrowRight
              class="size-3.5 transition-transform group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </span>
        </a>
      </li>
    ))}
  </ol>

  {watchOut && (
    <a
      href={`#${riskIds(data.risks)[riskIndex]}`}
      class="mt-3 flex items-start gap-3 focus-inset rounded-xl border-l-4 border-amber-500 bg-raised p-4 no-underline hover:ring-2 hover:ring-accent/40"
      data-testid="watch-out"
    >
      <AlertTriangle
        class="mt-0.5 size-5 shrink-0 text-amber-600 dark:text-amber-400"
        aria-hidden="true"
      />
      <span>
        <span class="block text-sm font-semibold">Watch out for</span>
        <span class="block text-sm leading-relaxed text-muted">
          {watchOut.headline ?? watchOut.text}
        </span>
      </span>
    </a>
  )}

  <dl class="mt-4 grid gap-4 text-sm sm:mt-5 sm:grid-cols-2">
    <div>
      <dt class="mb-1.5 font-medium">Tools to try first</dt>
      <dd class="flex flex-wrap gap-2">
        {topTools.map(({ entry }) => (
          <a
            href={entry.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="print-url inline-flex min-h-11 items-center gap-1.5 rounded-full border border-line bg-raised px-3.5 py-2 no-underline hover:border-accent"
          >
            {entry.data.name}
            <ExternalLink
              class="no-print size-3 text-muted"
              aria-hidden="true"
            />
            <span class="sr-only">(opens in new tab)</span>
          </a>
        ))}
      </dd>
    </div>
    <div class="hidden sm:block">
      <dt class="mb-1.5 font-medium">Skills to build</dt>
      <dd>
        <ul class="space-y-1">
          {topSkills.map((skill) => (
            <li class="flex gap-2">
              <Check
                class="mt-0.5 size-4 shrink-0 text-accent"
                aria-hidden="true"
              />
              <span>{skill}</span>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>

  <div class="no-print mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
    {firstSkill && (
      <a
        href={`#skill-${firstSkill.name}`}
        class="inline-flex items-center gap-1.5 text-accent"
        data-testid="try-skill"
      >
        Try a ready-made AI instruction: {firstSkill.title}
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    )}
    {!!data.first30Days?.length && (
      <a href="#start" class="inline-flex items-center gap-1.5 text-accent">
        See your first steps <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    )}
  </div>
</section>
