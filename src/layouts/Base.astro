---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "SDLC in the AI Era";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// `short` labels keep the phone header on one line.
const nav = [
  { href: url("/"), label: "All roles", short: "Roles" },
  {
    href: url("/agent-skills"),
    label: "Agent Skills guide",
    short: "Skills",
  },
  { href: url("/about"), label: "About", short: "About" },
];
// Which nav item the current page belongs to (role and phase pages sit under "All roles").
const path = Astro.url.pathname.replace(/\/$/, "");
const base = url("/").replace(/\/$/, "");
const section = path.startsWith(`${base}/agent-skills`)
  ? 1
  : path.startsWith(`${base}/about`)
    ? 2
    : path === base ||
        path.startsWith(`${base}/roles`) ||
        path.startsWith(`${base}/phases`)
      ? 0
      : -1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "dark" && theme !== "light") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <header class="no-print border-b border-line">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-6">
        <a
          href={url("/")}
          class="flex shrink-0 items-center gap-2 font-semibold tracking-tight whitespace-nowrap no-underline"
        >
          <Logo class="size-6 sm:size-7" />
          <span>
            SDLC{" "}
            <span class="text-accent">
              <span class="max-[379px]:hidden">in the AI Era</span>
              <span class="hidden max-[379px]:inline">AI</span>
            </span>
          </span>
        </a>
        <div class="flex items-center gap-1 sm:gap-4">
          <nav aria-label="Main">
            <ul class="flex gap-0.5 text-sm whitespace-nowrap sm:gap-5">
              {nav.map((item, i) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={i === section ? "page" : undefined}
                    class="relative inline-flex min-h-11 items-center px-1 text-muted hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-1 aria-[current=page]:after:bottom-1.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-accent"
                  >
                    <span class="sm:hidden">{item.short}</span>
                    <span class="hidden sm:inline">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
    <footer class="mt-4 border-t border-line bg-surface/60">
      <div class="mx-auto grid max-w-6xl gap-4 px-4 pt-8 pb-20 text-sm text-muted sm:grid-cols-[1fr_auto] sm:gap-6 sm:px-6 sm:py-10">
        <div class="max-w-xl">
          <a
            href={url("/")}
            class="mb-2 inline-flex items-center gap-2 font-semibold text-ink no-underline"
          >
            <Logo class="size-6" />
            SDLC in the AI Era
          </a>
          <p class="leading-relaxed">
            A researched snapshot of how software roles are changing. Research
            claims link to their sources. Sections marked{" "}
            <em>Our suggestion</em> are the editor's practical advice. Each page
            shows its review date.
          </p>
          <span class="hidden print:mt-2 print:block">
            Online: {Astro.url.href}
          </span>
        </div>
        <nav aria-label="Footer" class="no-print">
          <ul class="flex flex-wrap gap-x-5 sm:grid sm:gap-1">
            <li>
              <a
                href={url("/")}
                class="inline-flex min-h-8 items-center text-ink underline decoration-line hover:decoration-accent sm:min-h-10"
              >
                All roles
              </a>
            </li>
            <li>
              <a
                href={url("/agent-skills")}
                class="inline-flex min-h-8 items-center text-ink underline decoration-line hover:decoration-accent sm:min-h-10"
              >
                Agent Skills guide
              </a>
            </li>
            <li>
              <a
                href={url("/about")}
                class="inline-flex min-h-8 items-center text-ink underline decoration-line hover:decoration-accent sm:min-h-10"
                data-testid="footer-about"
              >
                About &amp; method
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
