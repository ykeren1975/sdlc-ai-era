{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm install *)",
      "Bash(npx astro *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": ["Bash(git push *)", "Bash(rm -rf *)", "Read(./.env*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -r \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/prettier --write --ignore-unknown >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
